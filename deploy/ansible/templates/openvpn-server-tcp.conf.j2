# Optional TCP gateway for clients without UDP egress (for example behind an HTTP CONNECT proxy).
port {{ enderpin_vpn_tcp.port }}
proto tcp4-server
dev epvpn-tcp
dev-type tun
tun-mtu 1400
mssfix 1360
tcp-nodelay
topology subnet
server {{ hostvars.localhost.vpn_tcp_network.network }} {{ hostvars.localhost.vpn_tcp_network.netmask }} nopool
client-config-dir /etc/openvpn/server/enderpin-tcp/ccd
ccd-exclusive
max-clients {{ enderpin_vpn_tcp_clients | length }}
ca /etc/openvpn/server/enderpin/ca.crt
cert /etc/openvpn/server/enderpin/enderpin-gateway.crt
key /etc/openvpn/server/enderpin/enderpin-gateway.key
dh none
tls-crypt /etc/openvpn/server/enderpin/tls-crypt.key
remote-cert-tls client
tls-version-min 1.2
data-ciphers AES-128-GCM:CHACHA20-POLY1305:AES-256-GCM
allow-compression no
keepalive 10 60
persist-key
persist-tun
user nobody
group nogroup
verb 3
