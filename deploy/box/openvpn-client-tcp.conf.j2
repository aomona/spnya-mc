# Rendered by deploy/box/creative.py for a client whose only egress is an HTTP CONNECT proxy.
client
proto tcp-client
http-proxy {{ box.http_proxy.host }} {{ box.http_proxy.port }}
# The egress proxy may reset every tunnel at once; reconnect within seconds so that TCP sessions
# inside the tunnel (Velocity to creative, keepalive timeout 30 s) survive the gap.
connect-retry 1 5
server-poll-timeout 6
hand-window 20
pull-filter ignore "ping"
ping 5
ping-restart 30
dev epvpn
dev-type tun
tun-mtu 1400
mssfix 1360
remote {{ box.vpn_endpoint }} {{ box.vpn_port }}
nobind
resolv-retry infinite
route-nopull
ca /etc/openvpn/client/enderpin-tcp/ca.crt
cert /etc/openvpn/client/enderpin-tcp/client.crt
key /etc/openvpn/client/enderpin-tcp/client.key
tls-crypt /etc/openvpn/client/enderpin-tcp/tls-crypt.key
remote-cert-tls server
verify-x509-name enderpin-gateway name
tls-version-min 1.2
data-ciphers AES-128-GCM:CHACHA20-POLY1305:AES-256-GCM
allow-compression no
persist-key
persist-tun
user nobody
group nogroup
verb 3
