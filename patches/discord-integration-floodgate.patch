+    private boolean isAuthenticated(Player player) {
+        if (player.isOnlineMode()) {
+            return true;
+        }
+        if (!proxy.getPluginManager().isLoaded("floodgate")) {
+            return false;
+        }
+        try {
+            var api = FloodgateApi.getInstance();
+            var bedrock = api == null ? null : api.getPlayer(player.getUniqueId());
+            return bedrock != null && player.getUniqueId().equals(bedrock.getCorrectUniqueId());
+        } catch (LinkageError | RuntimeException exception) {
+            logger.warn("Unable to verify Floodgate identity; denying offline login.", exception);
+            return false;
+        }
+    }
